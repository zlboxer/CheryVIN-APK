#:kivy 2.0.0

<CalcLayout>:
    orientation: 'vertical'
    padding: 20
    spacing: 15

    Label:
        text: '奇瑞 VIN → PIN'
        font_size: '24sp'
        size_hint_y: None
        height: '50dp'

    TextInput:
        id: vin_input
        hint_text: '请输入17位VIN码'
        multiline: False
        font_size: '18sp'

    Button:
        text: '计算 PIN 码'
        font_size: '18sp'
        on_press: root.calculate_pin()

    Label:
        id: result_label
        text: ''
        font_size: '20sp'
        color: 0, 1, 0, 1
